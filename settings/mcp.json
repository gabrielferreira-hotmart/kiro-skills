{
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": [
        "@cyanheads/git-mcp-server"
      ],
      "disabled": true,
      "env": {
        "MCP_LOG_LEVEL": "error",
        "LOGS_DIR": "~/.mcp/cyanheads/git-mcp-server/"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "github-repos-manager-mcp@latest"
      ],
      "disabled": true,
      "env": {
        "GH_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "@sylphlab/tools-fetch-mcp"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.atlassian.com/v1/mcp/authv2"
      ],
      "disabled": true,
      "autoApprove": [
        "atlassianUserInfo",
        "getAccessibleAtlassianResources",
        "getVisibleJiraProjects",
        "getJiraIssue",
        "searchJiraIssuesUsingJql",
        "getTransitionsForJiraIssue",
        "getJiraIssueRemoteIssueLinks",
        "getJiraProjectIssueTypesMetadata",
        "getJiraIssueTypeMetaWithFields",
        "lookupJiraAccountId",
        "search",
        "fetch",
        "getConfluenceSpaces",
        "getPagesInConfluenceSpace",
        "getConfluencePage",
        "searchConfluenceUsingCql",
        "getConfluencePageFooterComments",
        "getConfluencePageInlineComments",
        "getConfluencePageDescendants"
      ]
    },
    "golden-path": {
      "command": "npx",
      "args": [
        "mcp-remote@v0.1.18",
        "https://mcp.hotmart.dev/golden-path/mcp"
      ],
      "env": {},
      "disabled": true
    },
    "astrolens": {
      "url": "https://astrolens-mcp-server.data.hotmart.com/mcp",
      "disabled": true,
      "autoApprove": [
        "search",
        "get_entities",
        "list_schema_fields",
        "get_lineage",
        "get_lineage_paths_between",
        "get_dataset_queries"
      ]
    },
    "mcp-datahub": {
      "url": "https://mcp.hotmart.dev/datahub/mcp",
      "disabled": true,
      "autoApprove": [
        "search_datahub_docs",
        "search_data_contract"
      ]
    },
    "figma": {
      "command": "/Users/gabriellopesferreira/.kiro/bin/figma-mcp.sh",
      "args": [],
      "disabled": false
    },
    "xcodebuild": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "disabled": true
    },
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools@latest",
        "experimental:mcp",
        "--only",
        "crashlytics,core"
      ],
      "disabled": true
    },
    "git-compressed": {
      "command": "/Users/gabriellopesferreira/.kiro/bin/git-compressed.sh",
      "args": [],
      "disabled": false
    },
    "github-compressed": {
      "command": "/Users/gabriellopesferreira/.kiro/bin/github-compressed.sh",
      "args": [],
      "env": {
        "GH_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false
    },
    "atlassian-compressed": {
      "command": "/Users/gabriellopesferreira/.kiro/bin/atlassian-compressed.sh",
      "args": [],
      "disabled": false
    }
  },
  "powers": {
    "mcpServers": {}
  }
}